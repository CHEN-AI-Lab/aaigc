# ============================================================
# AAIGC — Environment Variables
# ============================================================
# Copy this file to .env.local for local development.
# For Vercel deployment, set these in the Vercel dashboard.
# ============================================================

# --- Cloudflare Worker 统计网关 ---
# 统计 Worker 的地址，所有项目的统计请求通过此 Worker 发送到 Turso (libSQL) 数据库
# 部署 Worker 后填写实际地址
# NEXT_PUBLIC_WORKER_URL=https://your-worker-url

# --- Fallback 统计网关（国内用户兜底）---
# 当 Worker 不可达时（如国内用户），fallback 到此地址发送统计
# 指向 stats-dashboard 的 /track API
# NEXT_PUBLIC_FALLBACK_URL=https://your-fallback-url

# --- 项目部署地址 ---
# 项目的完整访问地址，用于 SEO（sitemap/robots）和元数据
# Preview 环境填 preview 域名，Production 环境填正式域名
# 多端 device flow 的授权页地址也由此拼出：<NEXT_PUBLIC_APP_URL>/device
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# --- Neon Postgres（用户系统 Phase 6）---
# 用户系统、收藏、评论等功能需要
# DATABASE_URL=postgresql://user:password@host:port/database        # 带 pooler，应用运行时用
# DIRECT_URL=postgresql://user:password@host:port/database          # 不带 pooler，Prisma 迁移用

# --- NextAuth.js ---
# 生成 AUTH_SECRET: openssl rand -base64 32
# AUTH_SECRET=

# --- Google OAuth ---
# 在 Google Cloud Console 创建 OAuth 2.0 凭据
# 回调 URL: https://your-domain.com/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# --- GitHub OAuth ---
# 在 GitHub Settings > Developer Settings > OAuth Apps 创建
# 回调 URL: https://your-domain.com/api/auth/callback/github
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# --- Resend（邮箱验证码发送）---
# 在 resend.com 注册免费账号，获取 API Key
# RESEND_API_KEY=
# MAIL_FROM=noreply@aaigc.online    # 必配！发件邮箱地址（纯邮箱，不带显示名）。
# 发件人显示名（如 "AAIGC"）已写死在代码里，各项目各自维护。
# 所有项目可统一配置同一个邮箱地址，只需配一次。

# --- 本地开发验证码（安全开关）---
# 设为 true 时，本地开发可在 API 响应中直接返回验证码（免邮件发送）。
# 部署环境（Vercel）即使误设也会被自动忽略——VERCEL_ENV 存在时不返回 devCode。
# ALLOW_DEV_CODE=true

# --- 本地开发 ---
# 现在需要数据库、NextAuth、Resend 等配置，详见上方说明
# 设置 .env.local 后运行 pnpm dev


# --- Vercel Cron 鉴权 ---
# 定时任务鉴权密钥。Vercel Cron 调用 /api/cron/* 时会自动附带
# `Authorization: Bearer <CRON_SECRET>` 头；未配置则定时任务会被路由拒绝。
# 在 Vercel Dashboard 设置，必须为强随机字符串。
# 生成命令: openssl rand -base64 32
# CRON_SECRET=


# ============================================================
# 多端补齐（小程序 / App / 桌面 / CLI）
# ============================================================
# 统一约定（SK-8）：以下变量**一律禁止在代码里写非空 fallback**。
# 「没配」就是「该能力不可用」，而不是「悄悄用一个内置默认值」。

# --- Bearer 通道 access token 签名密钥（必配）---
# 用于签发/校验 Bearer JWT（HS256，issuer=aaigc，audience=aaigc-clients，TTL 15 分钟）。
# 未配置时：所有 Bearer 请求一律 401，且不会冒泡成 500（不会用默认密钥）。
# 生成命令: openssl rand -base64 48
# AUTH_ACCESS_TOKEN_SECRET=

# --- API CORS 白名单（逗号分隔，可空）---
# 逗号分隔的完整 Origin 列表（含 scheme，不含路径、不含结尾斜杠）。
# 只服务「浏览器内核会带 Origin 的端」：桌面端 Tauri WebView（Origin = tauri://localhost）
# 与 App 的 WebView。小程序 wx.request 与 CLI fetch 不带 Origin，不受 CORS 约束，无需加入。
# 空值 = 不下发 Access-Control-Allow-Origin（默认全禁跨源），禁止写成 "*"。
# 示例（桌面端 Tauri WebView + 本地开发）：
# API_CORS_ORIGINS=tauri://localhost,http://localhost:3000

# ============================================================
# ⚠️ 上线前必读：DNS_DOH_ENDPOINTS / IP_GEO_ENDPOINTS / IP_ECHO_ENDPOINT
#    **未配置 = DNS 查询与 IP 归属查询两个线上工具直接失效**
#
# 代码没有硬编码兜底端点（SK-8 禁止非空 fallback），缺失一律按「服务未配置」处理：
#   · 未配 DNS_DOH_ENDPOINTS → /api/tools/dns-lookup 一律 503 {"error":"networkFailed"}
#   · 未配 IP_GEO_ENDPOINTS  → /api/tools/ip-lookup 查公网 IP 时 503 networkFailed
#   · 未配 IP_ECHO_ENDPOINT  → 取不到可信来源 IP 时 /api/tools/ip-lookup 503 networkFailed
#
# 这不是 bug，是 env 化的真实代价，已实测确认：
#   2026-09-20 dev 环境未配 DNS_DOH_ENDPOINTS 时
#   GET /api/tools/dns-lookup?name=example.com → 503 {"error":"networkFailed"}
# 因此**部署到 Vercel 前必须把这三个值都配上**，否则这两个工具上线即不可用。
# ============================================================

# --- 第三方服务端点（SK-8：禁止在代码里硬编码域名）---
# DNS-over-HTTPS 端点，逗号分隔，按顺序 failover。
# 未配置 → /api/tools/dns-lookup 返回 networkFailed（不会偷偷用内置域名）。
# 示例：DNS_DOH_ENDPOINTS=https://dns.alidns.com/resolve,https://dns.google/resolve
# DNS_DOH_ENDPOINTS=

# IP 归属地查询端点，逗号分隔，支持 {ip} 与 {lang} 占位符（值会被 URL encode）。
# 未配置 → /api/tools/ip-lookup 返回 networkFailed（不做非空 fallback）。
# 示例：IP_GEO_ENDPOINTS=https://ip-api.com/json/{ip}?lang={lang}
# IP_GEO_ENDPOINTS=

# 本机公网 IP 回显端点（当无法从请求头取得可信 IP 时使用）。
# 示例：IP_ECHO_ENDPOINT=https://api.ipify.org?format=json
# IP_ECHO_ENDPOINT=

# OAuth 解绑时的远端撤销端点（JSON 字符串）。
# ⚠️ 解析函数已就绪（shared/constants/endpoints.oauthRevokeEndpoints），
#    但 /api/user/unlink-account 目前仍用内联常量，待 T02.4 硬编码清理专项接线。
# OAUTH_REVOKE_ENDPOINTS_JSON={"google":"https://oauth2.googleapis.com/revoke"}

# --- 产品 URL 映射（替换 shared/data/products.ts 里的硬编码链接）---
# JSON: { "<productId>": { "url": "...", "previewUrl": "...", "productionUrl": "..." } }
# PRODUCT_URL_MAP_JSON={}

# --- 各端下载链接（/download 页用，P0-13）---
# JSON: { "<platform>": "<url>" }，platform ∈ weapp / app / desktop / cli
# 缺失的端在页面上显示「即将上线」，不做 fallback。
# NATIVE_APP_DOWNLOAD_URLS_JSON={"weapp":"","app":"","desktop":"","cli":""}

# --- 埋点开关（CLI / 桌面端默认关闭，Q10）---
# T03 CLI 已接入（apps/cli/src/core/config.ts）：1/true/yes/on 视为开启，其余一律关闭；
# 未设置时按 shared/constants/projects.ts 的 TELEMETRY_OFF_BY_DEFAULT_PLATFORMS 判定，
# 'cli' 在列 → 默认关闭。Web / 小程序 / App 不受此变量影响。
# ⚠️ T04 桌面端尚未接入（暂无代码读取）。
# AAIGC_TELEMETRY=false


# ============================================================
# CLI 端（T03）—— apps/cli/
# ============================================================
# CLI 独占的变量统一 `AAIGC_CLI_*` 前缀，避免与 App / 桌面端将来撞名。
# 唯一例外是 AAIGC_TELEMETRY（跨端共享开关，见上方同名小节）。
# 与 SK-8 一致：与外部服务地址相关的项**未配置即明确失败**，
# 代码里不存在任何内置默认域名/地址。

# --- API 基址（必填！）---
# 提供 AAIGC API 的站点 origin：scheme + host，不含路径（结尾斜杠会被自动去掉）。
# 未配置的后果：login / logout / favorites 三条命令全部以 cliConfigMissing 失败
#   （退出码 2），并提示怎么配。tools list / tools run 是本地纯函数、不联网，
#   不受影响，仍可正常使用。
# 单次覆盖：--api-base-url <url>
# 示例：AAIGC_CLI_API_BASE_URL=https://aaigc.online
# AAIGC_CLI_API_BASE_URL=

# --- 凭证目录（可选）---
# 存放凭证文件与 device-id 的目录。
# 目录以 0700 创建、文件以 0600 落盘，且一律在仓库之外。
# 未配置的后果：按 OS 惯例取默认位置 ——
#   Linux / macOS: $XDG_CONFIG_HOME/aaigc（未设 XDG_CONFIG_HOME 则 ~/.config/aaigc）
#   Windows:       %APPDATA%\aaigc
# 单次覆盖：--config-dir <dir>
# AAIGC_CLI_CONFIG_DIR=

# --- 凭证文件名（可选）---
# 只接受**纯文件名**（不含 / 或 \），落点恒为 <AAIGC_CLI_CONFIG_DIR>/<该文件名>。
# 含路径分隔符会被拒绝并报用法错误 —— 放开绝对路径等于绕开 0700/0600 这层保护。
# 未配置的后果：用 tokens.json。
# AAIGC_CLI_TOKEN_FILE=

# --- 输出语言（可选）---
# 取值同 --lang：en | zh-CN | zh-TW | ja。
# 未配置的后果：用默认语言 en。取值非法时以用法错误失败（退出码 2）并列出可选语言。
# AAIGC_CLI_LANG=

# --- 埋点开关（可选，详见上方同名小节；跨端共享，故不加 CLI 前缀）---
# AAIGC_TELEMETRY=false

# --- ⚠️ 以下变量**当前代码不读取**，写了不会生效，请勿写入部署配置 ---
# AAIGC_CLI_TELEMETRY_ENDPOINT：CLI 不持有任何上报地址（SK-8 禁止硬编码）。
#   上报端点由 shared/api/track.ts 统一从 NEXT_PUBLIC_WORKER_URL /
#   NEXT_PUBLIC_FALLBACK_URL 读取；两者都为空时 track() 直接返回 false —— 即静默不上报。
#   若确需让 CLI 走独立端点，得先给 shared 的 track() 加端点覆盖参数，属 shared 侧改动。

# ============================================================
# device flow 自动放行（仅本地 / CI！）
# ============================================================
# scripts/device-flow-auto-approve.mjs 的开关。**默认关闭**，不设则脚本直接退出并说明。
# ⚠️ 该脚本会跳过「用户必须在浏览器里亲手确认设备码」这一步，
#    **绝对禁止在任何部署环境（Preview / Production / 预发 / 线上）设为 1**。
# 脚本自身还有第二道闸：目标站点必须是本机（localhost / 127.0.0.1 / ::1），
#   指向远端一律拒绝执行；且它走的是既有登录链路（验证码换 Bearer），不绕过鉴权。
# 本地 e2e 用法：
#   ALLOW_DEVICE_FLOW_AUTO_APPROVE=1 node scripts/device-flow-auto-approve.mjs <userCode> --email you@example.com
# 前置：本机 dev server 已启动，且 ALLOW_DEV_CODE=true（否则拿不到 devCode）。
# ALLOW_DEVICE_FLOW_AUTO_APPROVE=
