# ============================================================
# AAIGC — Environment Variables
# ============================================================
# Copy this file to .env.local for local development.
# For Vercel deployment, set these in the Vercel dashboard.
# ============================================================

# --- Cloudflare Worker 统计网关 ---
# 统计 Worker 的地址，所有项目的统计请求通过此 Worker 发送到 Turso (libSQL) 数据库
# 部署 Worker 后填写实际地址
# NEXT_PUBLIC_WORKER_URL=https://your-worker-url

# --- Fallback 统计网关（国内用户兜底）---
# 当 Worker 不可达时（如国内用户），fallback 到此地址发送统计
# 指向 stats-dashboard 的 /track API
# NEXT_PUBLIC_FALLBACK_URL=https://your-fallback-url

# --- 项目部署地址 ---
# 项目的完整访问地址，用于 SEO（sitemap/robots）和元数据
# Preview 环境填 preview 域名，Production 环境填正式域名
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# --- Neon Postgres（用户系统 Phase 6）---
# 用户系统、收藏、评论等功能需要
# DATABASE_URL=postgresql://user:password@host:port/database        # 带 pooler，应用运行时用
# DIRECT_URL=postgresql://user:password@host:port/database          # 不带 pooler，Prisma 迁移用

# --- NextAuth.js ---
# 生成 AUTH_SECRET: openssl rand -base64 32
# AUTH_SECRET=

# --- Google OAuth ---
# 在 Google Cloud Console 创建 OAuth 2.0 凭据
# 回调 URL: https://your-domain.com/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# --- GitHub OAuth ---
# 在 GitHub Settings > Developer Settings > OAuth Apps 创建
# 回调 URL: https://your-domain.com/api/auth/callback/github
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# --- Resend（邮箱验证码发送）---
# 在 resend.com 注册免费账号，获取 API Key
# RESEND_API_KEY=
# MAIL_FROM=noreply@aaigc.online    # 必配！发件邮箱地址（纯邮箱，不带显示名）。
# 发件人显示名（如 "AAIGC"）已写死在代码里，各项目各自维护。
# 所有项目可统一配置同一个邮箱地址，只需配一次。

# --- 本地开发验证码（安全开关）---
# 设为 true 时，本地开发可在 API 响应中直接返回验证码（免邮件发送）。
# 部署环境（Vercel）即使误设也会被自动忽略——VERCEL_ENV 存在时不返回 devCode。
# ALLOW_DEV_CODE=true

# --- 本地开发 ---
# 现在需要数据库、NextAuth、Resend 等配置，详见上方说明
# 设置 .env.local 后运行 pnpm dev


# --- Vercel Cron 鉴权 ---
# 定时任务鉴权密钥。Vercel Cron 调用 /api/cron/* 时会自动附带
# `Authorization: Bearer <CRON_SECRET>` 头；未配置则定时任务会被路由拒绝。
# 在 Vercel Dashboard 设置，必须为强随机字符串。
# 生成命令: openssl rand -base64 32
# CRON_SECRET=
