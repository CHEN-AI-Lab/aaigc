{
  "name": "aaigc",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:shared": "pnpm --filter shared test",
    "typecheck": "pnpm --filter web exec -- tsc --noEmit && pnpm --filter shared exec -- tsc --noEmit",
    "check": "bash scripts/check.sh",
    "check:light": "bash scripts/check-light.sh",
    "check:syntax": "find . -name '*.mjs' -not -path '*/node_modules/*' -not -path '*/.next/*' -exec node --check {} \\;",
    "check:json": "python3 scripts/check-json.py",
    "check:type": "pnpm --filter shared exec -- tsc --noEmit && pnpm --filter web exec -- tsc --noEmit",
    "test:light": "pnpm vitest run --pool=forks --poolOptions.forks.singleFork --maxWorkers=1",
    "setup": "pnpm install",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.19.19",
    "husky": "^9.1.7",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
