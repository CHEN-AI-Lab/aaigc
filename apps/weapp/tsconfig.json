{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["@tarojs/taro", "@types/webpack-env", "@types/react"]
  },
  "include": ["./src", "./config", "./types", "../../shared/types", "../../shared/tools", "../../shared/constants"],
  "exclude": ["node_modules", "dist"]
}
