{
  "name": "weapp",
  "version": "0.1.0",
  "private": true,
  "description": "AAIGC WeChat mini-program (Taro v4 + React) — reuses shared/ TS source. Taro 一码编译多平台（h5/alipay/tt/swan/qq/kwai 等）。",
  "scripts": {
    "gen:theme": "node scripts/gen-theme.mjs",
    "build:weapp": "node scripts/gen-theme.mjs && taro build --type weapp",
    "dev:weapp": "node scripts/gen-theme.mjs && taro build --type weapp --watch",
    "build:h5": "node scripts/gen-theme.mjs && taro build --type h5",
    "dev:h5": "node scripts/gen-theme.mjs && taro build --type h5 --watch",
    "build:alipay": "node scripts/gen-theme.mjs && taro build --type alipay",
    "dev:alipay": "node scripts/gen-theme.mjs && taro build --type alipay --watch",
    "build:tt": "node scripts/gen-theme.mjs && taro build --type tt",
    "dev:tt": "node scripts/gen-theme.mjs && taro build --type tt --watch",
    "build:swan": "node scripts/gen-theme.mjs && taro build --type swan",
    "dev:swan": "node scripts/gen-theme.mjs && taro build --type swan --watch",
    "build:qq": "node scripts/gen-theme.mjs && taro build --type qq",
    "dev:qq": "node scripts/gen-theme.mjs && taro build --type qq --watch",
    "build:kwai": "node scripts/gen-theme.mjs && taro build --type kwai",
    "dev:kwai": "node scripts/gen-theme.mjs && taro build --type kwai --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-alipay": "4.2.1",
    "@tarojs/plugin-platform-kwai": "4.2.1",
    "@tarojs/plugin-platform-qq": "4.2.1",
    "@tarojs/plugin-platform-swan": "4.2.1",
    "@tarojs/plugin-platform-tt": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-react": "^7.24.1",
    "@tarojs/cli": "4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/react": "^18.3.12",
    "@types/webpack-env": "^1.13.6",
    "babel-preset-taro": "4.2.1",
    "typescript": "^5.7.0"
  }
}
