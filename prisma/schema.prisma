generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String?   @unique
  phone        String?   @unique    // 绑定手机号（不可解绑，见设置页提示）
  emailVerified DateTime?
  passwordHash String?              // bcrypt hash，仅密码用户有
  name         String?
  role         String   @default("user")  // "user" | "admin"
  image        String?              // OAuth 头像
  termsAgreedAt DateTime?           // 用户同意隐私政策的时间
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts Account[]
  sessions Session[]
  favorites Favorite[]
  refreshTokens RefreshToken[]
  deviceCodes  DeviceCode[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String?
  phone     String?
  code      String
  purpose   String   @default("verify") // 用途绑定：verify/login/register/forgotPassword/changePassword/deleteAccount，防止跨用途重放
  attempts  Int      @default(0)        // 失败尝试计数，达到阈值后该码失效
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, code])
  @@index([phone, code])
  @@index([email, purpose])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  type      String   @default("tool")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId, type])
  @@index([userId])
}

model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart BigInt   @default(0)
  lockedUntil BigInt?
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// 多端 Bearer 通道（架构 §4.2.1 / Q-A5）
// additive：仅新增表，不改动任何既有表，可过 check-migration-safety.sh
// ─────────────────────────────────────────────────────────────────────────────

/// refresh token —— 只存 SHA-256 hash，原文不落库（库泄露也无法冒用）。
/// familyId 用于「同一登录会话的 token 链」：一旦检测到已撤销 token 被重放，
/// 整族撤销（token 盗用检测，RFC 6749 rotation 最佳实践）。
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  familyId  String
  clientId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

/// device flow（CLI / 桌面端）：deviceCode 给设备轮询，userCode 给用户核对
model DeviceCode {
  id           String    @id @default(cuid())
  deviceCode   String    @unique
  userCode     String    @unique
  clientId     String
  userId       String?
  approvedAt   DateTime?
  consumedAt   DateTime?
  expiresAt    DateTime
  lastPolledAt DateTime?
  createdAt    DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}