#!/bin/sh
# pre-commit hook: structure check + type check + lint + test + translation safety
# 1. 结构检查（shared/ + apps/ 目录结构合规）
# 2. TypeScript 类型检查
# 3. Lint 检查
# 4. 单元测试（轻量 single fork 模式，WSL 安全）
# 5. 迁移安全检查
# 6-7. 翻译文件管理（自动学习 + 同步）

# 严格模式：通过手动捕获管道退出码实现 pipefail 效果（POSIX 兼容）

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM || true)

# Step 1: Structure check
echo "🔍 Running structure check..."
bash scripts/check-structure.sh || exit 1
echo "✅ Structure check passed"

# Step 2: TypeScript type check
echo "🔍 Running TypeScript type check..."
(cd apps/web && npx tsc --noEmit) > /tmp/tsc.log 2>&1
TSC_EXIT=$?
tail -20 /tmp/tsc.log
[ $TSC_EXIT -eq 0 ] || exit 1
echo "✅ TypeScript check passed"

# Step 3: Lint check
echo "🔍 Running lint check..."
(cd apps/web && npx eslint .) > /tmp/eslint.log 2>&1
ESLINT_EXIT=$?
tail -10 /tmp/eslint.log
[ $ESLINT_EXIT -eq 0 ] || exit 1
echo "✅ Lint check passed"

# Step 4: Unit tests (lightweight, single fork)
echo "🧪 Running unit tests..."
pnpm vitest run --pool=forks --poolOptions.forks.singleFork --maxWorkers=1 --reporter=verbose > /tmp/vitest.log 2>&1
VITEST_EXIT=$?
tail -10 /tmp/vitest.log
[ $VITEST_EXIT -eq 0 ] || exit 1
echo "✅ Tests passed"

# Step 5: 检查迁移文件是否有危险操作
MIG_FILES=$(echo "$STAGED_FILES" | grep '^prisma/migrations/' | grep 'migration.sql$' || true)
if [ -n "$MIG_FILES" ]; then
  echo "🔒 检测到迁移文件变动，输出变更内容供审查..."
  echo "=========================================="
  for FILE in $MIG_FILES; do
    echo "--- $FILE ---"
    git diff --cached "$FILE" 2>/dev/null || git show HEAD:"$FILE" 2>/dev/null
    echo ""
  done
  echo "=========================================="
  echo "⚠️  请确认上述迁移 SQL 无误后再提交。"
  echo "🔒 正在检查迁移安全性..."
  bash scripts/check-migration-safety.sh || exit 1
fi

# Step 6: 翻译文件（非源语言）有变动 → 自动学习
TRANS_FILES=$(echo "$STAGED_FILES" | grep '^shared/messages/' | grep -v 'en\\.json$' | grep -v 'zh-CN\\.json$' || true)
if [ -n "$TRANS_FILES" ]; then
  echo "📝 检测到翻译文件变动，正在更新记忆库..."
  for FILE in $TRANS_FILES; do
    LANG=$(basename "$FILE" .json)
    echo "   → $LANG"
    node scripts/translate.mjs "$LANG" --learn --yes 2>&1 | sed 's/^/     /'
  done
fi

# Step 7: 源语言文件（en/zh-CN）有变动 → 自动同步 + 询问是否自动翻译
SOURCE_FILES=$(echo "$STAGED_FILES" | grep '^shared/messages/\\(en\\|zh-CN\\)\\.json$' || true)
if [ -n "$SOURCE_FILES" ]; then
  echo "📝 检测到源语言文件变动，正在同步中英文对应关系..."
  node scripts/translate.mjs --sync 2>&1 | sed 's/^/     /'
  echo ""

  echo "📝 检测到源语言文件新增了 key，需要翻译其他语言"
  if [ -t 0 ]; then
    read -p "   是否立即自动翻译所有语言？(y/N) " ANSWER
    case "$ANSWER" in
      [yY]|[yY][eE][sS])
        echo "   🌐 正在翻译所有语言..."
        node scripts/translate.mjs --all 2>&1 | sed 's/^/     /'
        echo "   ✅ 翻译完成"
        # 重新暂存被翻译更新的文件
        git add shared/messages/*.json 2>/dev/null || true
        ;;
      *)
        echo "   💡 跳过翻译，后续可手动执行: node scripts/translate.mjs --all"
        ;;
    esac
  else
    echo "   💡 非交互环境，跳过翻译（后续可手动执行: node scripts/translate.mjs --all）"
  fi
fi